{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site Generation Request",
  "type": "object",
  "required": ["name", "baseUrl", "pages"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the site class"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "Base URL for the site"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "List of page names to register"
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of flow names"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the site"
    }
  }
}
