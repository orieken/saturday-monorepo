{
  "name": "@orieken/saturday-cucumber-indexer",
  "version": "0.1.0",
  "description": "A CLI tool to index Cucumber feature files for the Saturday framework.",
  "license": "MIT",
  "private": false,
  "bin": {
    "cuke-indexer": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "cucumber",
    "indexer",
    "saturday"
  ],
  "author": "Oscar Rieken",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.16",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^4.0.16"
  }
}
