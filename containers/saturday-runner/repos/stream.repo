# CentOS Stream 9: Xvfb and every Mesa package, which UBI lacks or splits.
# openssl* excluded so UBI's FIPS OpenSSL stays.
[stream-baseos]
name=CentOS Stream 9 BaseOS
baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
excludepkgs=openssl*

[stream-appstream]
name=CentOS Stream 9 AppStream
baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
excludepkgs=openssl*

[stream-crb]
name=CentOS Stream 9 CRB
baseurl=https://mirror.stream.centos.org/9-stream/CRB/x86_64/os/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
excludepkgs=openssl*
